{
  "name": "@holic512/slothtool",
  "version": "1.9.0",
  "description": "A plugin manager and dispatcher for CLI tools",
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "slothtool": "bin/slothtool.js"
  },
  "scripts": {
    "dev": "node bin/slothtool.js",
    "dev:loc": "node plugins/loc/bin/loc.js",
    "dev:image-compress": "node plugins/image-compress/bin/image-compress.js",
    "dev:gstore": "node plugins/gstore/bin/gstore.js",
    "dev:todo": "node plugins/todo/bin/todo.js",
    "dev:codex-models": "node plugins/codex-models/bin/codex-models.js",
    "test": "node --test"
  },
  "keywords": [
    "cli",
    "plugin",
    "tool",
    "manager"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/holic512/SlothTool"
  },
  "homepage": "https://github.com/holic512/SlothTool",
  "bugs": {
    "url": "https://github.com/holic512/SlothTool/issues"
  },
  "files": [
    "bin",
    "lib"
  ],
  "workspaces": [
    "plugins/loc",
    "plugins/gstore",
    "plugins/todo",
    "plugins/codex-models"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ink": "^7.0.4",
    "react": "^19.2.0"
  }
}
