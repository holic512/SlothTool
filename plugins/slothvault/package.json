{
  "name": "@holic512/plugin-slothvault",
  "version": "2.1.0",
  "description": "SlothVault deployment, coding-agent Skill, and separately registrable administrator MCP tooling for SlothTool",
  "main": "lib/service.js",
  "type": "module",
  "bin": {
    "slothvault": "bin/slothvault.js",
    "slothvault-mcp": "bin/slothvault-mcp.js"
  },
  "slothtool": {
    "interactive": true,
    "interactiveFlag": "-i",
    "ui": {
      "cli": true,
      "tui": true,
      "defaultMode": "tui",
      "tuiFlag": "--tui",
      "compatFlags": [
        "-i",
        "--interactive"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/skill-metadata.js"
  },
  "keywords": [
    "slothtool",
    "plugin",
    "slothvault",
    "mcp",
    "client"
  ],
  "author": "MengJiaXu",
  "license": "ISC",
  "files": [
    "bin",
    "deploy/README.md",
    "deploy/install.py",
    "deploy/slothvault_deploy/*.py",
    "deploy/tests/*.py",
    "lib",
    "skills",
    "README.md",
    "scripts/skill-metadata.js",
    "skill-release.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ink": "^7.0.4",
    "react": "^19.2.0"
  }
}
